# Configuration is read from process environment; this file is documentation, not auto-loaded.
PORT=4317
GEOBRIDGE_HOST=127.0.0.1
GEOBRIDGE_ORIGIN=http://127.0.0.1:4317
# Optional: operator-controlled exact sandbox hostnames, comma-separated. No wildcard.
GEOBRIDGE_ALLOWED_HOSTS=
# Configure securely in the server environment. Never commit real values.
GEOBRIDGE_AI_KEY=
GEOBRIDGE_AI_MODEL=
# Alternative: private server-side files, read at runtime. Direct environment values take priority.
# The Docker image defaults to these paths in the persistent data volume.
GEOBRIDGE_AI_KEY_FILE=
GEOBRIDGE_AI_MODEL_FILE=
# Optional ordered provider pool (OpenAI, Gemini, Claude, Grok or OpenAI-compatible).
# Private JSON file containing connection metadata and key-file paths; see docs/ai-provider-pool.md.
GEOBRIDGE_AI_POOL_FILE=
# Optional synthetic monitoring only. Targets are trusted operator configuration,
# never accepted from browser input. Admin keys stay in mounted secret files.
# Start disabled; enable under Monitoring. Do not put secret values in this JSON.
GEOBRIDGE_MOCK_TARGETS=[]
# Example process environment value (configure as one JSON string):
# [{"id":"gringott","name":"Gringott mock","origin":"http://gringott:4173","tenant":"bank-demo","adminKeyFile":"/run/secrets/gringott-admin.key"}]
